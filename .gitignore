# Generated from project.yml by xcodegen. Never edit or commit it.
# Run `make gen` after cloning, or `make build` which does it for you.
baia.xcodeproj/

# Local build output and the resolved package checkouts
.build/
DerivedData/

# `xcodebuild` invoked without `-derivedDataPath` drops one of these in the repo
# root and in every local package. Nothing reads them and nothing should: the
# tracked build output path is `.build/`, with the dot.
build/

# Agent worktrees, created inside the repo by subagent-driven work
.claude/worktrees/

# Plan execution state. Ephemeral coordination for a run in progress, not
# project history: the plan itself is in the vault and the commits are the record.
.claude/plan-state.json
.claude/progress.md

# Xcode user state
*.xcuserstate
xcuserdata/
*.xcscmblueprint
.swiftpm/

# macOS
.DS_Store

# The Claude Design conversation, under design/. Two of its three folders are
# working traffic and stay local, one per direction: `inbox/` is design to code,
# `handoffs/` is code to design. Both are large, both go stale the moment the UI
# changes, and the captures in handoffs/ regenerate from the real app via
# Diagnostics/lib/capture.sh, which is tracked because it is the part worth
# keeping. The design system beside them is none of those things, so
# `design/vitreous/` is tracked and maintained like source.
design/inbox/
design/handoffs/

verify-out/

# Recreated by `make upstream` from the revision and patch beside it. A path pin
# is machine-local, so the checkout is derived rather than tracked.
upstream/libghostty-spm/

# Python bytecode from the diagnostics probes
__pycache__/
*.pyc
.superpowers/

# The graphify code graph, rebuilt from the AST by `python3 -m graphify update .`
# and derived rather than tracked: graph.json alone is 8.7MB and every rebuild
# rewrites it. The community labels are the exception. They are hand-approved
# prose, they are what makes the graph navigable in Obsidian, and a rebuild in a
# fresh clone would silently fall back to "Community 0" without them. The
# membership snapshot beside them stays local, since it is a baseline for the
# alignment check on this machine's graph rather than a shared fact.
graphify-out/**
!graphify-out/
!graphify-out/.community_labels.json

# Runtime portal metadata created when orb services are exposed.
.amp/portals/*
