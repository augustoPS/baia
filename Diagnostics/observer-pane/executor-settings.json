{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(make test)",
      "Bash(make test:*)",
      "Bash(make build)",
      "Bash(make gen)",
      "Bash(make CONFIG=Release build)",
      "Bash(swift test:*)",
      "Bash(swift build:*)",
      "Bash(swift run:*)",
      "Bash(swift Icon/make-icon.swift)",
      "Bash(cd:*)",
      "Bash(sed:*)",
      "Bash(chmod:*)",
      "Bash(bash -n:*)",
      "Bash(rtk make test)",
      "Bash(rtk make test:*)",
      "Bash(rtk make build)",
      "Bash(rtk make gen)",
      "Bash(rtk make CONFIG=Release build)",
      "Bash(rtk swift test:*)",
      "Bash(rtk swift build:*)",
      "Bash(rtk swift run:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(cmp:*)",
      "Bash(plutil:*)",
      "Bash(which:*)",
      "Bash(brew --prefix:*)",
      "Bash(brew list:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(printf:*)",
      "Bash(echo:*)",
      "Bash(rtk:*)",
      "Bash(baia:*)",
      "Read(/__REPO__/**)"
    ],
    "deny": [
      "Bash(pkill:*)",
      "Bash(rtk proxy:*)",
      "Bash(xcodebuild:*)",
      "Bash(xargs:*)",
      "Bash(rtk xcodebuild:*)",
      "Bash(make run)",
      "Bash(make run-attached)",
      "Bash(open:*)",
      "Bash(osascript:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash __REPO__/Diagnostics/observer-pane/guard-baia-alive.sh"
          }
        ]
      }
    ]
  }
}
