@@ -111,6 +111,54 @@ public final class TerminalSurface {
         }
     }
 
+    // MARK: - Text
+
+    /// Reads the terminal's text for a point-tag scope.
+    ///
+    /// `GHOSTTY_POINT_SCREEN` covers the scrollback as well as the visible
+    /// rows, which is what a find-in-terminal needs; `GHOSTTY_POINT_VIEWPORT`
+    /// is the visible rows only.
+    public func readText(scope: ghostty_point_tag_e) -> String? {
+        guard let s = surface else { return nil }
+        let topLeft = ghostty_point_s(
+            tag: scope, coord: GHOSTTY_POINT_COORD_TOP_LEFT, x: 0, y: 0
+        )
+        let bottomRight = ghostty_point_s(
+            tag: scope, coord: GHOSTTY_POINT_COORD_BOTTOM_RIGHT, x: 0, y: 0
+        )
+        let selection = ghostty_selection_s(
+            top_left: topLeft, bottom_right: bottomRight, rectangle: false
+        )
+        var out = ghostty_text_s()
+        guard ghostty_surface_read_text(s, selection, &out) else { return nil }
+        defer { ghostty_surface_free_text(s, &out) }
+        guard let ptr = out.text, out.text_len > 0 else { return "" }
+        let bytes = UnsafeBufferPointer(start: ptr, count: Int(out.text_len))
+            .map { UInt8(bitPattern: $0) }
+        return String(decoding: bytes, as: UTF8.self)
+    }
+
+    /// Reads a single screen row, by exact coordinate.
+    public func readRow(_ row: UInt32, columns: UInt32) -> String? {
+        guard let s = surface else { return nil }
+        let left = ghostty_point_s(
+            tag: GHOSTTY_POINT_SCREEN, coord: GHOSTTY_POINT_COORD_EXACT, x: 0, y: row
+        )
+        let right = ghostty_point_s(
+            tag: GHOSTTY_POINT_SCREEN, coord: GHOSTTY_POINT_COORD_EXACT,
+            x: columns &- 1, y: row
+        )
+        let selection = ghostty_selection_s(
+            top_left: left, bottom_right: right, rectangle: false
+        )
+        var out = ghostty_text_s()
+        guard ghostty_surface_read_text(s, selection, &out) else { return nil }
+        defer { ghostty_surface_free_text(s, &out) }
+        guard let ptr = out.text, out.text_len > 0 else { return "" }
+        return String(decoding: UnsafeBufferPointer(start: ptr, count: Int(out.text_len))
+            .map { UInt8(bitPattern: $0) }, as: UTF8.self)
+    }
+
