#!/usr/bin/env bash
set -euo pipefail

step_started=$SECONDS
echo "[orb setup] checking Debian packages"
packages=(
    binutils
    ca-certificates
    curl
    gcc
    git
    gpg
    libcurl4-openssl-dev
    libedit-dev
    libicu-dev
    libncurses-dev
    libpython3-dev
    libsqlite3-dev
    libstdc++-12-dev
    libxml2-dev
    pkg-config
    tzdata
    unzip
    uuid-dev
    zip
)
missing=()
for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q '^install ok installed$'; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    privilege=()
    if ((EUID != 0)); then
        privilege=(sudo)
    fi
    "${privilege[@]}" apt-get update
    "${privilege[@]}" env DEBIAN_FRONTEND=noninteractive \
        apt-get install -y --no-install-recommends "${missing[@]}"
fi
echo "[orb setup] Debian packages ready in $((SECONDS - step_started))s"

swiftly_home="${SWIFTLY_HOME_DIR:-$HOME/.local/share/swiftly}"
if [[ ! -x "$swiftly_home/bin/swiftly" ]]; then
    step_started=$SECONDS
    echo "[orb setup] installing swiftly"
    case "$(uname -m)" in
        x86_64|aarch64) architecture="$(uname -m)" ;;
        *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
    esac
    temporary_directory="$(mktemp -d)"
    trap 'rm -rf "$temporary_directory"' EXIT
    curl --fail --location --silent --show-error \
        "https://download.swift.org/swiftly/linux/swiftly-1.1.3-${architecture}.tar.gz" \
        --output "$temporary_directory/swiftly.tar.gz"
    tar -xzf "$temporary_directory/swiftly.tar.gz" -C "$temporary_directory"
    "$temporary_directory/swiftly" init \
        --assume-yes \
        --skip-install \
        --quiet-shell-followup
    echo "[orb setup] swiftly ready in $((SECONDS - step_started))s"
fi

# swift.org's installer writes this file for both this process and future login shells.
# shellcheck disable=SC1090
source "$swiftly_home/env.sh"

step_started=$SECONDS
echo "[orb setup] selecting Swift 6.2"
if ! swiftly run 6.2 swift --version >/dev/null 2>&1; then
    swiftly install 6.2 --assume-yes
fi
swiftly use 6.2 --global-default --assume-yes
swift --version | head -1
echo "[orb setup] Swift ready in $((SECONDS - step_started))s"

step_started=$SECONDS
echo "[orb setup] preparing libghostty-spm"
make upstream
swift package resolve --package-path Packages/PaneChrome
echo "[orb setup] dependencies ready in $((SECONDS - step_started))s"

echo "[orb setup] complete"
