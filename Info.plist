<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>baia</string>
	<!-- Named without the .icns extension, which is what CFBundleIconFile takes.
	     Generated by Icon/make-icon.swift and copied in as a resource by the
	     target's build phase; there is no asset catalog in this project. -->
	<key>CFBundleIconFile</key>
	<string>baia</string>
	<key>CFBundleDisplayName</key>
	<string>baia</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!-- Programs running inside the terminal get microphone access attributed to
	     baia as the responsible process. Claude Code voice dictation is the case
	     that matters here. Without this string plus the audio-input entitlement,
	     macOS denies the request silently and never shows a prompt. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Programs you run inside baia may record audio, such as voice dictation in a coding agent.</string>
</dict>
</plist>
