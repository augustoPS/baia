<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- Named without the .icns extension, which is what CFBundleIconFile takes.
	     Generated by Icon/make-icon.swift and copied in as a resource by the
	     target's build phase; there is no asset catalog in this project.
	     PRODUCT_NAME already varies per configuration (`baia` for Release,
	     `baia-dev` for Debug) and matches the two icon files' names exactly, so
	     reusing it here is what picks the right icon per build. -->
	<key>CFBundleIconFile</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- The directory under Application Support holding session.json,
	     control.sock and recent-projects.tsv. Set per configuration in
	     project.yml: `baia` for Release, `baia-dev` for Debug, so the installed
	     copy and the build under test do not share a socket or a window list.
	     Read by SupportDirectory at launch. Settings are not split; they stay at
	     ~/.config/baia/config.json for both. -->
	<key>BAIASupportDirectory</key>
	<string>$(BAIA_SUPPORT_DIRECTORY)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The commit the bundle was built from: short hash, plus `-dirty` when the
	     tree carried uncommitted or untracked changes at build time. Both
	     versions above are hand-edited constants that cannot tell two builds a
	     month apart apart, so this is the only thing in the bundle that names
	     its source.

	     Computed by `make build` and passed on the xcodebuild command line,
	     since no build setting can run git; `BAIA_GIT_COMMIT` in project.yml
	     defaults it to `unknown` for a build that does not come through the
	     Makefile. Read it with
	     `defaults read /Applications/baia.app/Contents/Info BAIAGitCommit`. -->
	<key>BAIAGitCommit</key>
	<string>$(BAIA_GIT_COMMIT)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!-- Programs running inside the terminal get microphone access attributed to
	     baia as the responsible process. Claude Code voice dictation is the case
	     that matters here. Without this string plus the audio-input entitlement,
	     macOS denies the request silently and never shows a prompt. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Programs you run inside baia may record audio, such as voice dictation in a coding agent.</string>
</dict>
</plist>
